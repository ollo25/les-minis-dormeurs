# Ignore build output directories
/bin/
/obj/

# Godot 4+ specific ignores
# Tout .godot/ est ignoré SAUF extension_list.cfg : le livrer évite les 10 erreurs rouges 'FmodServer'
# au tout premier import (testé le 17/10/2026, voir docs/logs/premier-import-avec-extension-list.log).
**/.godot/*
!**/.godot/extension_list.cfg

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

.claude/
CLAUDE.md
.DS_Store
# Hackathon oct. 2026 : fichiers temporaires et résidus à ne jamais distribuer
*.tmp
~*.dll
*.import.tmp
ConversationTrack.md
docs/logs/*.bak
__pycache__/
