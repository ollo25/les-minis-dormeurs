; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/banks_path="res://Sons & musiques/Fichiers FMOD/FmodBank/Desktop"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Godot_Blocks"
run/main_scene="res://Scènes/Demo_Prof/Start.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
boot_splash/image="res://Ne pas toucher/Godot Blocks screen.png"
config/icon="res://Ne pas toucher/Godot Blocks logo.png"

[autoload]

g_vars="*res://Ne pas toucher/Scripts/g_vars.gd"
ArduinoManager="*uid://cd8gwrj6qyt62"
FmodManager="*uid://cds10pm7hwn3p"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/fmod/plugin.cfg", "res://addons/gdserial/plugin.cfg")

[file_customization]

folder_colors={
"res://Ne pas toucher/": "red"
}

[filesystem]

import/fbx/enabled=false

